  "components": [
    {
      "name": "Primary continuation",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "A real next section or continuation action at the learning boundary.",
      "html": "<button class=\"ds-forward\">Next section <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-forward{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 15px;border:1px solid transparent;border-radius:8px;background:var(--button,#1B5C48);color:var(--selectionText,#FFFFFF);font:600 14px/1.4 var(--ui-font,Inter,\"Segoe UI\",sans-serif);cursor:pointer}.ds-forward:hover:not(:disabled){filter:brightness(.97)}.ds-forward:disabled{opacity:.45;cursor:default}.ds-forward:focus-visible{outline:2px solid var(--focus,#176858);outline-offset:3px}"
    },
    {
      "name": "Secondary back",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A quiet bordered prior-section action with the same stationary target.",
      "html": "<button class=\"ds-back\">Back</button>",
      "css": ".ds-back{min-height:44px;padding:10px 15px;border:1px solid var(--border,#C8D5C7);border-radius:8px;background:transparent;color:var(--text,#1C3028);font:600 14px/1.4 var(--ui-font,Inter,\"Segoe UI\",sans-serif);cursor:pointer}.ds-back:hover:not(:disabled){filter:brightness(.97)}.ds-back:disabled{opacity:.45;cursor:default}.ds-back:focus-visible{outline:2px solid var(--focus,#176858);outline-offset:3px}"
    },
    {
      "name": "Contextual Ask",
      "kind": "button",
      "refersTo": "button-contextual",
      "description": "The deliberate contextual question action, selected when its panel is open.",
      "html": "<button class=\"ds-ask\" aria-expanded=\"true\">Ask about this page</button>",
      "css": ".ds-ask{min-height:44px;padding:10px 15px;border:0;border-radius:8px;background:transparent;color:var(--text,#1C3028);font:600 14px/1.4 var(--ui-font,Inter,\"Segoe UI\",sans-serif);cursor:pointer}.ds-ask[aria-expanded=\"true\"]{background:var(--selected,#D8EAD6)}.ds-ask:hover{filter:brightness(.97)}.ds-ask:focus-visible{outline:2px solid var(--focus,#176858);outline-offset:3px}"
    },
    {
      "name": "Subject search field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "The themed native field used to find an actual subject.",
      "html": "<label class=\"ds-search\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input aria-label=\"Find a subject\" placeholder=\"Find a subject\"></label>",
      "css": ".ds-search{display:inline-flex;align-items:center;gap:9px;min-height:40px;padding:0 12px;border:1px solid var(--border,#C8D5C7);border-radius:8px;background:var(--input,#FDFEF9);color:var(--text,#1C3028)}.ds-search input{width:180px;padding:9px 0;border:0;background:transparent;color:inherit;font:14px/1.5 var(--ui-font,Inter,\"Segoe UI\",sans-serif)}.ds-search input::placeholder{color:var(--secondary,#4C6356)}.ds-search input:focus-visible{outline:2px solid var(--focus,#176858);outline-offset:3px}"
    },
    {
      "name": "Global course navigation",
      "kind": "nav",
      "refersTo": "appbar",
      "description": "Deep identity band with foreground-colored descendant labels.",
      "html": "<nav class=\"ds-global\" aria-label=\"Course navigation sample\"><button aria-current=\"page\"><span>My learning</span></button><button><span>Lesson</span></button><button><span>Library</span></button></nav>",
      "css": ".ds-global{display:flex;align-items:center;gap:3px;min-height:64px;padding:0 24px;background:var(--learning-identity,var(--button,#1B5C48));color:var(--learning-identity-text,var(--selectionText,#FFFFFF))}.ds-global button{min-height:38px;padding:9px 13px;border:0;border-radius:8px;background:transparent;color:inherit;font:13px/1.5 var(--ui-font,Inter,\"Segoe UI\",sans-serif);cursor:pointer}.ds-global button span{color:inherit;font-size:inherit;opacity:1}.ds-global button[aria-current],.ds-global button:hover{background:color-mix(in srgb,var(--learning-identity-text,var(--selectionText,#FFFFFF)) 15%,transparent)}.ds-global button:focus-visible{outline:2px solid currentColor;outline-offset:3px}"
    },
    {
      "name": "Connected section trail",
      "kind": "nav",
      "refersTo": "section-step",
      "description": "Real ordered lesson sections with a current step and numbered circles.",
      "html": "<nav class=\"ds-trail\" aria-label=\"Lesson sections sample\"><button><span class=\"ds-number\">1</span><span>Read the message</span></button><button aria-current=\"step\"><span class=\"ds-number\">2</span><span>Take a gradient step</span></button></nav>",
      "css": ".ds-trail{position:relative;display:flex;gap:4px;padding:5px 4px 3px;overflow-x:auto;background:var(--reading,#FDFEF9)}.ds-trail:before{content:\"\";position:absolute;top:23px;left:20px;right:20px;height:1px;background:var(--divider,#DCE5D8)}.ds-trail button{position:relative;display:flex;flex:0 0 180px;align-items:center;gap:9px;padding:7px 10px 7px 6px;border:0;border-radius:8px;background:var(--reading,#FDFEF9);color:var(--secondary,#4C6356);text-align:left;font:13px/1.4 var(--ui-font,Inter,\"Segoe UI\",sans-serif);cursor:pointer}.ds-trail button[aria-current]{background:var(--selected,#D8EAD6);color:var(--heading,#15362A);font-weight:650}.ds-number{display:grid;place-items:center;flex:0 0 28px;width:28px;height:28px;border:1px solid var(--border,#C8D5C7);border-radius:50%;background:var(--reading,#FDFEF9);font-size:12px}.ds-trail [aria-current] .ds-number{background:var(--accent,#1B6D56);border-color:var(--accent,#1B6D56);color:var(--selectionText,#FFFFFF)}.ds-trail button:hover{filter:brightness(.97)}.ds-trail button:focus-visible{outline:2px solid var(--focus,#176858);outline-offset:3px}"
    },
    {
      "name": "Course container",
      "kind": "card",
      "refersTo": "course-container",
      "description": "A flat, bordered subject container with real saved context and a divided action boundary.",
      "html": "<article class=\"ds-course\"><h2>Subject title</h2><p>The learner’s saved objective belongs here.</p><div class=\"ds-course-footer\"><span>Actual saved learning context</span><button aria-label=\"Open subject\">Open <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button></div></article>",
      "css": ".ds-course{display:flex;flex-direction:column;min-height:213px;padding:25px 27px 0;border:1px solid var(--border,#C8D5C7);border-radius:14px;background:var(--reading,#FDFEF9);color:var(--text,#1C3028);font:15px/1.6 var(--ui-font,Inter,\"Segoe UI\",sans-serif);transition:background 160ms ease,border-color 160ms ease}.ds-course:hover{background:var(--surface,#F5F8F1);border-color:var(--accent,#1B6D56)}.ds-course h2{margin:0 0 10px;color:var(--heading,#15362A);font-size:23px;font-weight:600;line-height:1.25;letter-spacing:-.02em}.ds-course p{margin:0 0 20px;color:var(--secondary,#4C6356)}.ds-course-footer{display:flex;align-items:center;justify-content:space-between;gap:22px;margin-top:auto;padding:15px 0;border-top:1px solid var(--divider,#DCE5D8);font-size:14px}.ds-course button{display:inline-flex;align-items:center;gap:8px;padding:5px;border:0;border-radius:8px;background:transparent;color:inherit;font:inherit;cursor:pointer}.ds-course button:hover{background:var(--hover,#E3EFE2)}.ds-course button:focus-visible{outline:2px solid var(--focus,#176858);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-course{transition-duration:0s}}"
    },
    {
      "name": "Coverage status",
      "kind": "chip",
      "refersTo": "coverage-status",
      "description": "A quiet semantic status label; covered and demonstrated remain distinct meanings.",
      "html": "<span class=\"ds-status\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"m8 12 3 3 5-6\"/></svg>Demonstrated</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:5px;color:var(--secondary,#4C6356);font:10px/1.6 var(--ui-font,Inter,\"Segoe UI\",sans-serif)}"
    }
  ],
  "narrative": {
    "northStar": "The campus learning itinerary",
    "overview": "A contemporary course workspace gives subjects, their actual pathways and focused lesson sections a clear order. A deep green identity band, pale green neutral grounds and an openly licensed sans-serif give the application a calm, direct character. Compact native controls leave room for readable explanations and working scientific figures.\n\nThe signature is a connected, selectable section trail beside the subject pathway. Home, course overview and focused learning use one visual language; a contextual tutor and secondary History support it. The rejected folio's permanent prompt dock and transcript-first hierarchy are confirmed anti-references. The material is digital, without simulated paper or decorative raster imagery.",
    "keyCharacteristics": [
      "Deep green identity with independent light, dark and custom appearance.",
      "Real subject pathways and numbered lesson-section trails.",
      "Readable prose and broad inline scientific working space.",
      "Compact task controls and restrained rounded containers.",
      "Contextual questions, secondary history and honest evidence labels."
    ],
    "rules": [
      {
        "name": "The Learner Configuration Rule",
        "body": "Factory tokens are defaults. Preserve independent edited palettes and fonts; version 4 upgrades only eligible untouched factory configurations. A single edited color prevents that factory replacement.",
        "section": "colors"
      },
      {
        "name": "The Identity Foreground Rule",
        "body": "Navigation and every nested label use the identity foreground. Recorded native 13px navigation contrast is 7.86:1 in light and 13.13:1 in dark; these measurements support that specific repair, not complete accessibility conformance.",
        "section": "colors"
      },
      {
        "name": "The Reading Independence Rule",
        "body": "Preserve reading size and scientific-label scale. Make space by reducing presentation layers and applying the actual responsive layout.",
        "section": "typography"
      },
      {
        "name": "The Flat Working Surface Rule",
        "body": "Reserve depth for temporary controls. Give working figures room through layout rather than ornamental shadows or smaller geometry.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the learner's semantic palette and independent typography settings throughout new surfaces.",
      "**Do** preserve the real pathway, original content order, reading position and scientific instance state.",
      "**Do** give readable explanations and meaningful working geometry the main lesson area.",
      "**Do** expose keyboard focus, honest pending/error states and the difference between coverage and demonstrated understanding.",
      "**Do** label local examples, controlled acceptance content and scientific approximations honestly.",
      "**Do** cite final native captures and scoped verification records with their actual limits."
    ],
    "donts": [
      "**Don't** restore the rejected folio's permanent prompt dock, transcript-first hierarchy or compulsory right laboratory.",
      "**Don't** overwrite a custom palette or font to force the factory identity.",
      "**Don't** add decorative eyebrows, text-glyph icons or hard offset shadows to this world.",
      "**Don't** manufacture mastery, XP, streaks, source pages, remaining quota or numerical scientific evidence.",
      "**Don't** shrink teaching type or scientific geometry to compensate for unnecessary presentation chrome.",
      "**Don't** infer complete release or accessibility verification from captures or the two-fix design verdict."
    ]
  }
}
